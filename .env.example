# 이 파일을 .env로 복사한 뒤 실제 값을 넣는다. (.env는 커밋하지 않음)

# 공공데이터포털 > 마이페이지 > 일반 인증키(Decoding)
DATA_GO_KR_KEY=여기에_인증키

# MySQL (docker-compose.yml이 읽음). MYSQL_USER는 docker/mysql-init.sql과 같게 'nutri'로 둔다
MYSQL_ROOT_PASSWORD=root_비밀번호
MYSQL_DATABASE=nutrition
MYSQL_USER=nutri
MYSQL_PASSWORD=nutri_비밀번호

# 앱·적재 스크립트가 쓰는 접속 주소 (비밀번호는 위 MYSQL_PASSWORD와 같게)
DATABASE_URL=mysql+pymysql://nutri:nutri_비밀번호@127.0.0.1:3306/nutrition?charset=utf8mb4
# 테스트 전용 DB (실제 데이터와 분리)
TEST_DATABASE_URL=mysql+pymysql://nutri:nutri_비밀번호@127.0.0.1:3306/nutrition_test?charset=utf8mb4

# Redis 캐시 (v2). 비워 두면 캐시 없이 DB만 쓴다
REDIS_URL=redis://127.0.0.1:6379/0
# 테스트 전용 Redis DB 번호 (실제 캐시와 분리)
TEST_REDIS_URL=redis://127.0.0.1:6379/1

# 로그인 토큰(JWT) 서명 키 (v3). 길고 임의인 값으로: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=여기에_임의의_긴_값
